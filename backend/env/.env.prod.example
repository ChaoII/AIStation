# ==================================
# 生产环境配置文件模版
# 复制此文件为 .env.prod 并修改配置
# ==================================

ENVIRONMENT = "prod"

# 服务器配置
SERVER_HOST = 'localhost'     # 允许访问的IP地址
SERVER_PORT = 8001          # 服务端口

# 文档配置
DEBUG = False                       # 调试模式
TITLE = "🎉 AIStation 🎉 -prod"  # 文档标题
VERSION = '0.1.0'                   # 版本号
SUMMARY = "接口汇总"                 # 文档概述
DOCS_URL = "/docs"                  # Swagger UI路径
REDOC_URL = "/redoc"                # ReDoc路径
ROOT_PATH = "/api/v1"               # API路由前缀
DESCRIPTION = "该项目是一个基于python的web服务框架，基于fastapi和sqlalchemy实现。"  # 文档描述

# 是否启用演示模式
DEMO_ENABLE = False

# 数据库配置
DATABASE_TYPE = "mysql"     # mysql、postgres、sqlite、dm(sqlite、dm不支持代码生成)

# 数据库配置
DATABASE_HOST = "your_database_host"
DATABASE_PORT = 3306        # MySQL默认端口3306 PostgreSQL默认端口5432
DATABASE_USER = "root"      # PostgreSQL 用户是 postgres
DATABASE_PASSWORD = "your_database_password"
DATABASE_NAME = "aistation"

# Redis配置
REDIS_ENABLE = True 
REDIS_HOST = "your_redis_host"
REDIS_PORT = 6379
REDIS_USER = ''
REDIS_PASSWORD = 'your_redis_password'
REDIS_DB_NAME = 1

# 日志配置
LOGGER_LEVEL = 'INFO'

# ==================================
# 安全配置（生产必填，缺失/弱值将拒绝启动）
# ==================================
# JWT 密钥：必须 >=32 字符且不得使用源码内置/示例默认值，建议随机生成：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY = "CHANGE_ME_随机生成的强密钥_至少32字符"
# JWT 签发者（iss），签发与校验均强制
JWT_ISSUER = "aistation"

# 推理回调共享密钥：必须配置非公开值，否则拒绝启动/回调
INFERENCE_CALLBACK_TOKEN = "CHANGE_ME_推理回调共享密钥"
# 仅本地联调使用：未配置回调密钥时放行（生产严禁开启）
INFERENCE_CALLBACK_ALLOW_INSECURE_DEV = False

# ZLM 录像完成 Webhook 共享密钥：默认空即拒绝回调，生产必须配置
RECORD_WEBHOOK_TOKEN = "CHANGE_ME_录像回调共享密钥"

# CORS：生产建议显式域名白名单；使用通配 '*' 时会强制关闭携带凭据
# ALLOW_ORIGINS = ["https://your.domain"]
# ALLOW_CREDENTIALS = False

# 大模型配置
OPENAI_BASE_URL = "https://api.deepseek.com"
OPENAI_API_KEY = "your_api_key"
OPENAI_MODEL = "deepseek-chat"
